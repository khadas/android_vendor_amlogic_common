// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    //   SPDX-license-identifier-LGPL
    //   legacy_by_exception_only (by exception only)
    //   legacy_proprietary
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

bootstrap_go_package {
    name: "soong-videofirm",
    pkgPath: "android/soong/vendor/amlogic/common/prebuilt/videofirm",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
        "soong-tee_common"
    ],
    srcs: [
        "tee_videofirm.go",
    ],
    pluginFor: ["soong_build"],
}

libtee_load_video_fw_go_defaults {
    name: "libtee_load_video_fw_bp_module",
}

tee_preload_fw_go_defaults {
    name: "tee_preload_fw_bp_module",
}

cc_prebuilt_library_shared {
    name: "libtee_load_video_fw",
    compile_multilib: "both",
    defaults: ["libtee_load_video_fw_bp_module"],
    strip: {
        none: true,
    },
    proprietary: true,
    shared_libs: [
        "libteec",
    ],
}

cc_prebuilt_binary {
    name: "tee_preload_fw",
    defaults: ["tee_preload_fw_bp_module"],
    vendor: true,
    init_rc: ["tee_preload_fw.rc"],
    check_elf_files: false,
}
