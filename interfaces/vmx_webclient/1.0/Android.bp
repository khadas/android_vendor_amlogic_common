package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

aidl_interface {
    name: "vendor.amlogic.hardware.vmx_webclient",
    owner: "vendor.amlogic.hardware.vmx_webclient",
    vendor_available: true,
    srcs: ["vendor/amlogic/hardware/vmx_webclient/*.aidl"],
    imports: [
        "android.hardware.common-V2",
    ],
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            min_sdk_version: "current",
        },
    },
    double_loadable: true,
}
