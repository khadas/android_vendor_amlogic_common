<?xml version="1.0" encoding="utf-8"?>
<manifest
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0"
    package="com.khadas.ksettings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk android:minSdkVersion="23"/>

    <!--android:sharedUserId="android.uid.system"-->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SettingsBase">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Status_bar_Preference"
            android:label="@string/Status_bar_control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CameraPreference"
            android:label="@string/camera_settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LEDs_Preference"
            android:label="@string/LEDs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DisplaySound_Preference"
            android:label="@string/DisplaySound_Setting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LogoLED_Preference"
            android:label="@string/Logo_LED_control">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Gsensor_Preference"
            android:label="@string/Gsensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    <receiver android:name=".BootReceiver">
        <intent-filter android:priority="2147483647">
            <action android:name="android.intent.action.BOOT_COMPLETED"/>
        </intent-filter>
    </receiver>

    <activity
        android:name=".PinMultipleActivity"
        android:label="@string/pin_multiple"
        android:exported="true" >
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
	      </intent-filter>
   </activity>

    <activity
        android:name=".BootupAppsSettingActivity"
        android:theme="@style/Theme.SettingsBase"
        android:label="@string/bootup_app_setting">
	    <intent-filter>
                <action android:name="android.intent.action.MAIN" />
	    </intent-filter>
    </activity>

    <activity
        android:name=".KeepAliveAppsSettingActivity"
        android:theme="@style/Theme.SettingsBase"
        android:label="@string/keep_alive_app_setting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
	    </intent-filter>
    </activity>
    </application>

</manifest>
