package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

cc_library_headers {
    name: "libwifi-hal-mdnsoffload_headers",
    vendor_available: true,
    export_include_dirs: [
        ".",
    ],
}

cc_library_shared {
    name: "libwifi-hal-mdnsoffload",
    system_ext_specific: true,
    compile_multilib: "first",
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libnl",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-format",
        "-Wno-reorder",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-unused-variable",
    ],
    srcs: [
        "wifi_mdns_offload.c",
    ],
	local_include_dirs: ["."],
	export_include_dirs: ["."],
    sanitize: {
        cfi: true,
        integer_overflow: true,
    },
}

cc_binary {
    name: "wifimdnsoffload",
    system_ext_specific: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-format",
        "-Wno-reorder",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-unused-variable",
    ],
    shared_libs: [
        "libwifi-hal-mdnsoffload",
    ],
    srcs: ["wifi_mdns_offload_main.c"],
	local_include_dirs: ["."],
}
