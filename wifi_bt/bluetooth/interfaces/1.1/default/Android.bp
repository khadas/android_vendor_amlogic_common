package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

cc_library_static {
    name: "android.hardware.bluetooth-async-droidlogic",
    vendor: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "async_fd_watcher.cc",
    ],
    export_include_dirs: ["."],
    shared_libs: [
        "liblog",
    ],
}

cc_library_static {
    name: "android.hardware.bluetooth-hci-droidlogic",
    vendor: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hci_packetizer.cc",
        "hci_protocol.cc",
        "h4_protocol.cc",
        "mct_protocol.cc",
    ],
    export_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}



cc_binary {
    name: "android.hardware.bluetooth@1.1-service-droidlogic",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.bluetooth@1.1-service-droidlogic.rc"],
    srcs: [
        "service.cpp",
        "bluetooth_hci.cc",
        "bluetooth_address.cc",
        "vendor_interface.cc",
        "multibt_hal.cc",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libhardware_legacy",
        "android.hardware.bluetooth@1.0-impl",
        "android.hardware.bluetooth@1.1",

        "android.hardware.bluetooth@1.0",
    ],

    static_libs: [
        "android.hardware.bluetooth-hci",
        "android.hardware.bluetooth-async-droidlogic",
        "android.hardware.bluetooth-hci-droidlogic",
    ],

    include_dirs: [
        "packages/modules/Bluetooth/system/hci/include",
        "hardware/libhardware_legacy/include",
    ],
}
