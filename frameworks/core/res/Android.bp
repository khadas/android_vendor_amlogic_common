// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_frameworks_core_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-MIT
    //   legacy_by_exception_only (by exception only)
    //   legacy_notice
    //   legacy_proprietary
    default_applicable_licenses: [
        "vendor_amlogic_common_license",
    ],
}

subdirs = ["jni",]
prebuilt_etc {
    name: "droidlogic_permissions.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "droidlogic_permissions.xml",
    filename_from_src: true,
}

android_library {
    name: "droidlogic-res-lib",
    srcs: [
        "**/*.java",
        "src/com/droidlogic/audioservice/services/IAudioSystemCmdService.aidl",
        "src/com/droidlogic/audioservice/services/IAudioEffectsService.aidl",
    ],

    manifest: "AndroidManifest_common.xml",
    resource_dirs: ["res"],
    platform_apis: true,

    libs: [
        "droidlogic.software.core",
        "android.hidl.base-V1.0-java",
        "android.hidl.manager-V1.0-java",
    ],

    static_libs: [
        "vendor.amlogic.hardware.tvserver-V1.0-java",
        "vendor.amlogic.hardware.droidvold-V1.0-java",
        "vendor.amlogic.hardware.systemcontrol-V1.0-java",
        "vendor.amlogic.hardware.systemcontrol-V1.1-java",
        "android.hardware.tv.hdmi.cec-V1-java",
    ],

}

android_app {
    name: "droidlogic-res",

    privileged: true,
    system_ext_specific: true,
    platform_apis: true,

    resource_dirs: [],
    certificate: "platform",
    static_libs: ["droidlogic-res-lib"],
    uses_libs: ["droidlogic.software.core"],

    required: [
        "droidlogic.software.core",
        "droidlogic_permissions.xml",
        "libjniuevent",
    ],

    optimize: {
        enabled: false,
    },

}
