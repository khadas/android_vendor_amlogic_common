<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.droidlogic"
    android:sharedUserId="android.uid.system">

    <permission-group
        android:name="droidlogic.permission-group.SYSTEM_CONTROL"
        android:label="@string/droidlogic_perm_group_label"
        android:description="@string/droidlogic_perm_group_description" />

    <permission
        android:name="droidlogic.permission.SYSTEM_CONTROL"
        android:permissionGroup="droidlogic.permission-group.SYSTEM_CONTROL"
        android:protectionLevel="signature"
        android:label="@string/droidlogic_perm_system_control_label"
        android:description="@string/droidlogic_perm_system_control_description" />

    <protected-broadcast android:name="droidlogic.audioservice.action.AUDIO_FORMAT" />
    <protected-broadcast android:name="droidlogic.intent.action.SYSTEM_CONTROL_EVENT" />
    <protected-broadcast android:name="com.amlogic.ACTION_LAUNCH_BENCH_APP" />

    <protected-broadcast android:name="com.droidvold.action.MEDIA_REMOVED" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_UNMOUNTED" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_CHECKING" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_MOUNTED" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_BAD_REMOVAL" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_UNMOUNTABLE" />
    <protected-broadcast android:name="com.droidvold.action.MEDIA_EJECT" />
    <protected-broadcast android:name="android.hardware.hdmi.action.OSD_MESSAGE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="droidlogic.permission.SYSTEM_CONTROL" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.HDMI_CEC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.CONTROL_KEYGUARD" />
    <uses-permission android:name="android.permission.SET_TIME" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED"/>
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG"/>
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG"/>
    <uses-permission android:name="android.permission.TV_INPUT_HARDWARE"/>

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="com.google.android.permission.GLOBAL_BUTTON" />

    <!-- Limit only for Android TV -->
    <uses-feature android:name="android.software.leanback"
         android:required="true"/>
    <uses-feature android:name="android.software.live_tv"
         android:required="true"/>

    <application android:name=".DroidlogicApplication"
                 android:persistent="true"
                 android:hasCode="true"
                 android:label="@string/droidlogic_system_label"
                 android:allowClearUserData="false"
                 android:killAfterRestore="false"
                 android:icon="@drawable/ic_launcher_droidlogic"
                 android:supportsRtl="true"
                 android:defaultToDeviceProtectedStorage="true"
                 android:directBootAware="true">
        <uses-library android:name="droidlogic.software.core" />

        <receiver android:exported="true"
                 android:name="com.droidlogic.UsbCameraReceiver"
                 android:singleUser="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>

        <service android:exported="true" android:name="com.droidlogic.ThermalService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.ShutdownService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.NtpService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.NetflixService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.hdmi.HdmiCecService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.EsmService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.DDRBandwidthService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.NetworkSwitchService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.DroidLogicPowerService" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.SubtitleDisplayer" android:enabled="true" android:singleUser="true" />
        <service android:exported="true" android:name="com.droidlogic.DroidLogicBenchService" android:singleUser="true" />
        <service android:name="com.droidlogic.PrebuiltChannelsService"
             android:singleUser="true"
             android:enabled="true"
             android:exported="true">
             <intent-filter>
                 <action android:name="com.droidlogic.PrebuiltChannelsService" />
             </intent-filter>
         </service>

        <service android:name=".AiPqService"
            android:enabled="true"
            android:exported="true">
        </service>
        <receiver android:name=".AiPqReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:exported="true"
                  android:name="com.droidlogic.BootComplete"
                  android:singleUser="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PRE_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:exported="true"
                  android:name="com.droidlogic.EthernetWifiSwitch"
                  android:singleUser="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>
        <receiver android:exported="true"
                  android:name="com.droidlogic.GlobalKeyReceiver"
                  android:singleUser="true">
            <intent-filter>
                <action android:name="android.intent.action.GLOBAL_BUTTON" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.droidlogic.database.DataProvider"
            android:authorities="com.droidlogic.database"
            android:exported="true">
            <!--android:writePermission="com.droidlogic.database.WRITE_DATA">-->
        <grant-uri-permission android:pathPattern="/tv_control_scan" />
        <grant-uri-permission android:pathPattern="/tv_control_sound" />
        <grant-uri-permission android:pathPattern="/tv_control_pppoe" />
        <grant-uri-permission android:pathPattern="/tv_control_others" />
        <grant-uri-permission android:pathPattern="/prop_table" />
        <grant-uri-permission android:pathPattern="/string_table" />
        <grant-uri-permission android:pathPattern="/tv_rrt" />
        </provider>

        <receiver android:exported="true"
                  android:name="com.droidlogic.btpair.FastBootComplete"
                  android:singleUser="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service android:exported="true"
                 android:name="com.droidlogic.btpair.DialogBluetoothService"
                 android:singleUser="true" />
        <service android:exported="true"
                 android:name=".audioservice.services.AudioSystemCmdService">
            <intent-filter>
                <action android:name="com.droidlogic.audioservice.services.AudioSystemCmdService" />
            </intent-filter>
        </service>

        <service android:exported="true"
                 android:name=".audioservice.services.AudioEffectsService">
            <intent-filter>
                <action android:name="com.droidlogic.audioservice.services.AudioEffectsService" />
            </intent-filter>
        </service>

        <receiver
            android:exported="true"
            android:name="com.droidlogic.btpair.BluetoothAutoPairReceiver"
            android:enabled="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service android:name="com.droidlogic.DeviceControlService"
                 android:enabled="true"
                 android:exported="true">
        </service>
    </application>

</manifest>
