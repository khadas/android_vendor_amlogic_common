{
    "logcat": {
        "path": "/system/bin/logcat",   // the logcat path
        "logBuffers": "all",
        "saveName": "locgat",
        "format": "threadtime,usec,printable",
        "rotateKBytes": "4096",        // each file is 4M
        "rotateCounts": "512",         // Max keep 512 files, this means we can record 512*4096 = 2G logcat logs.
    },

    "uboot": {
        "cmdline": "loglevel=0",
        "cmdline": "printk.devkmsg=on",
        "cmdline": "initcall_debug=1",
    },

    "sysfs_write": {
        "/sys/class/amhdmitx/amhdmitx0/debug": "1",
        "/proc/sys/kernel/printk": "3",                 //Never allowed! cannot work!
    },

    "property": {
        "vendor.media.test": "test",
        "persist.vendor.bt_debug": "2",
        "vendor.tv.test": "test",
    },
}