package {
    default_applicable_licenses: ["system_ext_logging_logcat_license"],
}

// Added automatically by a large-scale-change
license {
    name: "system_ext_logging_logcat_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_static  {
    name: "liblogpersist",
    //vendor_available: true,
    srcs: [
        "main.cpp",
        "signalHandler.cpp",
        "NetlinkHandler.cpp",
        "NetlinkManager.cpp",
        "UserLogConfig.cpp"
    ],
     cflags: [
        "-fno-omit-frame-pointer",
        "-Wno-writable-strings",
     ],
    whole_static_libs: [
        "libjsoncpp",
        "libc++fs",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libsysutils",
        "libutils",
    ],
}

cc_binary {
    name: "logpersist",
    system_ext_specific: true,
    init_rc: ["logcatd_ext.rc"],


     cflags: [
        "-fno-omit-frame-pointer",
        "-Wno-writable-strings",
        "-Wno-unused-parameter",
     ],

    whole_static_libs: [
        "liblogpersist",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "liblogwrap",
        "libsysutils",
        "libutils",
    ],
}

