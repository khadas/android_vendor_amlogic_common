package {
    default_applicable_licenses: [
        "vendor_amlogic_common_frameworks_services_systemcontrol_license",
    ],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "vendor_amlogic_common_frameworks_services_systemcontrol_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "legacy_by_exception_only", // by exception only
        "legacy_notice",
        "legacy_proprietary",
        "legacy_unencumbered",
    ],
    license_text: [
        "LICENSE",
    ],
}

soong_config_module_type_import {
    from: "device/amlogic/common/soong_config/Android.bp",
    module_types: ["amlogic_vendorconfig_cc_defaults"],
}

amlogic_vendorconfig_cc_defaults {
    name: "systemcontrol_defaults",
    cflags: [
      "-Wno-unused-function",
      "-Wno-unused-parameter",
      "-Wno-unused-variable",
      "-Wno-unused-label",
      "-Werror", // must fix warnings(except unused).
    ],

    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        },
    },

    soong_config_variables: {
        board_platform: {
            meson8: {
                cflags: ["-DMESON8_ENVSIZE"],
            },
            gxbaby: {
                cflags: ["-DGXBABY_ENVSIZE"],
            },
            gxtvbb: {
                cflags: ["-DGXTVBB_ENVSIZE"],
            },
            gxl: {
                cflags: ["-DGXL_ENVSIZE"],
            },
        },

        hwc_dynamic_switch_viu: {
            cflags: ["-DHWC_DYNAMIC_SWITCH_VIU"],
        },

        systemcontrol_display_type: {
            TV: {
                cflags: ["-DSYSTEMCONTROL_DISPLAY_TYPE=\"TV\""],
            },
            MID: {
                cflags: ["-DSYSTEMCONTROL_DISPLAY_TYPE=\"MID\""],
            },
            MBOX: {
                cflags: ["-DSYSTEMCONTROL_DISPLAY_TYPE=\"MBOX\""],
            },
        },

        systemcontrol_ui_type: {
            HD: {
                cflags: ["-DSYSTEMCONTROL_UI_TYPE=720"],
            },
            FHD: {
                cflags: ["-DSYSTEMCONTROL_UI_TYPE=1080"],
            },
            UHD: {
                cflags: ["-DSYSTEMCONTROL_UI_TYPE=2160"],
            },
        },
    },
}

// build for normal mode
// for systemcontrol client
cc_library_shared {
    name: "libsystemcontrolservice",
    defaults: ["systemcontrol_defaults"],
    vendor_available: true,
    system_ext_specific: true,
    recovery_available: true,

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    srcs: [
        "SystemControlClient.cpp",
    ],
    export_include_dirs: [
        "PQ/include",
        ".",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libbase",
        "libhidlbase",
    ],
}

//for systemcontrol service
cc_binary {
    name: "systemcontrol",
    defaults: ["systemcontrol_defaults"],

    cflags: [
        "-DHDCP_AUTHENTICATION",
        "-DFRAMERATE_MODE",
    ],

    srcs: [
        "main_systemcontrol.cpp",
        "ubootenv/Ubootenv.cpp",
        "logo_img_packer/res_pack.cpp",
        "logo_img_packer/crc32.cpp",
        "VdcLoop.c",
        "Rect.cpp",
        "SystemControlHal.cpp",
        "SystemControlClient.cpp",
        "SystemControlService.cpp",
        "DisplayMode.cpp",
        "DisplayModeMgr.cpp",
        "Dimension.cpp",
        "FrameRateMessage.cpp",
        "SysTokenizer.cpp",
        "UEventObserver.cpp",
        "HDCP/HdcpKeyDecrypt.cpp",
        "HDCP/HDCPRxKey.cpp",
        "HDCP/HDCPRxAuth.cpp",
        "HDCP/HDCPTxAuth.cpp",
        "HDCP/sha1.cpp",
        "HDCP/HDCPRx22ImgKey.cpp",
        "FrameRateAutoAdaption.cpp",
        "FormatColorDepth.cpp",
        "provision/ProvisionKey.cpp",
    ],

    shared_libs: [
        "libbase",
        "libhidlbase",
        "libcutils",
        "libutils",
        "liblog",
        "libbinder",
        "libm",
        "libpqcontrol",
        "libsqlite",
        "libjsoncpp",
        "libfbc",
        "vendor.amlogic.hardware.droidvold@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libmeson_display_adapter_remote",
        "libprovision",
        "libvideotunnel"
    ],

    init_rc: ["systemcontrol.rc"],

    static_libs: [
        "libz",
        "libsceneprocess_static",
        "libsyswrite_static",
    ],

    proprietary: true,
}

// build for recovery mode
// =========================================================
cc_binary {
    name: "systemcontrol_static",
    defaults: ["systemcontrol_defaults"],

    cflags: [
         "-DRECOVERY_MODE",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
    ],

    srcs: [
        "main_recovery.cpp",
        "ubootenv/Ubootenv.cpp",
        "logo_img_packer/res_pack.cpp",
        "logo_img_packer/crc32.cpp",
        "DisplayMode.cpp",
        "DisplayModeMgr.cpp",
        "SysTokenizer.cpp",
        "UEventObserver.cpp",
        "HDCP/HdcpKeyDecrypt.cpp",
        "HDCP/HDCPRxKey.cpp",
        "HDCP/HDCPRxAuth.cpp",
        "HDCP/HDCPTxAuth.cpp",
        "FrameRateAutoAdaption.cpp",
        "FormatColorDepth.cpp",
    ],

    static_libs: [
        "libz",
        "libjsoncpp",
        "libmeson_display_adapter_local_static",
        "libsceneprocess_recovery_static",
        "libsyswrite_recovery_static",
        "libbase",
        "libcutils",
    ],

    recovery: true,
    //proprietary: true,
}

cc_library_static {
    name: "libsystemcontrol_static",
    defaults: ["systemcontrol_defaults"],
    vendor_available: true,
    recovery_available: true,

    srcs: [
        "ubootenv/Ubootenv.cpp",
        "logo_img_packer/res_pack.cpp",
        "logo_img_packer/crc32.cpp",
        "DisplayMode.cpp",
        "DisplayModeMgr.cpp",
        "SysTokenizer.cpp",
        "UEventObserver.cpp",
        "HDCP/HdcpKeyDecrypt.cpp",
        "HDCP/HDCPRxKey.cpp",
        "HDCP/HDCPRxAuth.cpp",
        "HDCP/HDCPTxAuth.cpp",
        "HDCP/sha1.cpp",
        "HDCP/HDCPRx22ImgKey.cpp",
        "FrameRateAutoAdaption.cpp",
        "FormatColorDepth.cpp",
        "provision/ProvisionKey.cpp",
    ],

    static_libs: [
        "libcutils",
        "libz",
    ],

    shared_libs: [
        "libbase",
        "liblog",
    ],

    export_include_dirs: [
        ".",
        "ubootenv",
        "PQ/include"
    ],

    whole_static_libs: [
        "libmeson_display_adapter_local_static",
        "libsceneprocess_recovery_static",
        "libsyswrite_recovery_static",
    ],

    include_dirs: [
        "external/zlib",
        "external/libcxx/include",
        "system/core/libutils/include",
    ],
    cflags: [
        "-DRECOVERY_MODE",
    ],
}
