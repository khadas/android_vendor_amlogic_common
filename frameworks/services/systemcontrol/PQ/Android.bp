// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    default_applicable_licenses: [
        "vendor_amlogic_common_frameworks_services_systemcontrol_PQ_license",
    ],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "vendor_amlogic_common_frameworks_services_systemcontrol_PQ_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "legacy_by_exception_only", // by exception only
        "legacy_notice",
        "legacy_proprietary",
        "legacy_unencumbered",
    ],
    license_text: [
        "LICENSE",
    ],
}

bootstrap_go_package {
    name: "soong-droidlogic_pq",
    pkgPath: "android/soong/vendor/amlogic/common/frameworks/services/systemcontrol/PQ",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "droidlogic_pq.go",
    ],
    pluginFor: ["soong_build"],
}

soong_config_module_type_import {
    from: "device/amlogic/common/soong_config/Android.bp",
    module_types: ["amlogic_vendorconfig_cc_defaults"],
}

amlogic_vendorconfig_cc_defaults {
    name: "pqcontrol_defaults",

    soong_config_variables: {
        build_livetv: {
            cflags: ["-DSUPPORT_TVSERVICE"],
            //shared_libs: ["libtvbinder"], needed, but added in go.
        },
    },
}

pqcontrol_go_defaults {
    name: "pqcontrol_go_defaults",
}

cc_library_shared {
    name: "libpqcontrol",
    defaults: ["pqcontrol_defaults", "pqcontrol_go_defaults"],
    srcs: [
        "CPQdb.cpp",
        "COverScandb.cpp",
        "CPQControl.cpp",
        "CDevicePollCheckThread.cpp",
        "CPQColorData.cpp",
        "CEpoll.cpp",
        "CDynamicBackLight.cpp",
        "CHlgToneMapping.cpp",
        "CDolbyVision.cpp",
		"GammaOperation.cpp",
    ],

    export_include_dirs: [
        "utils/include",
        "include",
    ],

    include_dirs: [
        "vendor/amlogic/common/frameworks/native/amlhal/hal_inc",
    ],

    shared_libs: [
        "vendor.amlogic.hardware.tvserver@1.0",
        "libsqlite",
        "libutils",
        "liblog",
        "libcutils",
        "libbinder",
        "libfbc",
        "libvideotunnel",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libaml_hal_lcd",
        "libaml_hal_pq",
        "libaml_hal_dv",
        "libaml_hal_vdin",
    ],

    static_libs: [
        "pq.utils_static",
        "libsyswrite_static",
        "pq.tcon_demura_static",
        "pq.tcon_pgamma_static",
        "pq.tcon_common_static",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-DANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION",
    ],

    proprietary: true,

}
