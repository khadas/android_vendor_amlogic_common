//================================
//common

// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_frameworks_services_systemcontrol_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_by_exception_only (by exception only)
    //   legacy_notice
    //   legacy_proprietary
    default_applicable_licenses: [
        "vendor_amlogic_common_frameworks_services_systemcontrol_license",
    ],
}

soong_config_module_type_import {
    from: "device/khadas/common/soong_config/Android.bp",
    module_types: ["amlogic_vendorconfig_cc_defaults"],
}

amlogic_vendorconfig_cc_defaults {
    name: "sceneprocess_defaults",
    cflags: [
      "-Wno-unused-function",
      "-Wno-unused-parameter",
      "-Wno-unused-variable",
      "-Wno-unused-label",
      "-Werror", // must fix warnings(except unused).
    ],
}

cc_library_static {
    name: "libsyswrite_static",
    vendor_available: true,
    defaults: ["sceneprocess_defaults"],

    srcs: [
        "SysWrite.cpp",
    ],

    export_include_dirs: [
        "include",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
    ],
}

cc_library_static {
    name: "libsceneprocess_static",
    vendor_available: true,
    defaults: ["sceneprocess_defaults"],

    srcs: [
        "SceneProcess.cpp",
    ],

    export_include_dirs: [
        "include",
    ],

    static_libs: [
        "libsyswrite_static",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
    ],

}

//for recovery mode
cc_library_static {
    name: "libsyswrite_recovery_static",
    vendor_available: true,
    recovery_available: true,
    defaults: ["sceneprocess_defaults"],

    srcs: [
        "SysWrite.cpp",
    ],

    export_include_dirs: [
        "include",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-DRECOVERY_MODE",
    ],
}

cc_library_static {
    name: "libsceneprocess_recovery_static",
    vendor_available: true,
    recovery_available: true,
    defaults: ["sceneprocess_defaults"],

    srcs: [
        "SceneProcess.cpp",
    ],

    export_include_dirs: [
        "include",
    ],

    static_libs: [
        "libsyswrite_recovery_static",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
        "-DRECOVERY_MODE",
    ],
}
