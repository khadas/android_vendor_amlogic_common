    //   legacy_proprietary
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}
cc_library_shared {
  name: "libscreencontrolservice",
  vendor: true,
  cflags: [
    "-std=c++17",
  ],
  srcs: [
    "ScreenCatch/ScreenCatch.cpp",
    "Media2Ts/VideoEncoderWrapper.cpp",
    "Media2Ts/esconvertor.cpp",
    "Media2Ts/tspack.cpp",
    "ScreenControlH264.cpp",
    "ScreenManager.cpp",
    "ScreenControlDebug.cpp",
  ],
  include_dirs: [
    "frameworks/native/headers/media_plugin/media/hardware",
    "frameworks/av/drm/libmediadrm/interface/mediadrm",
    "frameworks/av/media/module/foundation/include/media/stagefright/foundation/",
    "frameworks/av/include",
    "frameworks/native/libs/gui/include",
    "hardware/amlogic/gralloc/amlogic",
    "hardware/amlogic/hwcomposer/mesondisplay/include",
  ],
  local_include_dirs: [
      "include",
  ],
  shared_libs: [
    "vendor.amlogic.hardware.screencontrol@1.0",
    "libbase",
    "libutils",
    "libcutils",
    "liblog",
    "libbinder",
    "libhidlbase",
    "libhardware",
    "libdl",
    "libui",
    "libstagefright_foundation",
    "libmedia_omx",
    "libmediandk",
    "libamgralloc_ext",
    "libmeson_display_adapter_remote",
    "libyuv",
  ],
}

